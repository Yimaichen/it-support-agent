# Never put a real credential into this example file.
DEEPSEEK_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
DATA_DIR=data
DATABASE_PATH=runtime/support.sqlite3
# All active conversations use Pi. Pre-Pi history is read-only.
PI_RUNTIME_DIR=runtime/pi
MAX_MODEL_ATTEMPTS=12
MAX_TOOL_CALLS=24
TURN_TIMEOUT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=45
MAX_ADDITIONAL_RETRIES=2

# Default stays disabled until full comparison demonstrates a benefit.
THINKING_MODE=disabled
REASONING_EFFORT=high
MAX_OUTPUT_TOKENS=8192
MAX_REPORTED_TOKENS=200000
